# Cấu hình cổng chạy Server
PORT=3000

# Đường dẫn tới file Service Account JSON tải từ Firebase Console
# Tải tại: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# (Tuỳ chọn) Topic mặc định cho kho lạnh
DEFAULT_NOTIFICATION_TOPIC=kholanh_alerts
